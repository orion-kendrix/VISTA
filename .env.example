# VISTA Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git. Only .env.example is committed.
# Maintained by: the integration phase (Phase 3). Every variable used anywhere
# in netlify/functions/ MUST be listed here with a comment (RULES.md R4).

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=                     # Project URL: Supabase dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=        # Service role key (NOT anon key) — server-side only
SUPABASE_STORAGE_BUCKET=certificates   # Public storage bucket for certificate images
                                       # (create it once: Storage > New bucket > public)

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=                   # 
GEMINI_MODEL=gemini-2.5-flash     # Override if Google renames/sunsets the model

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=               # LinkedIn Developer Portal > your app > Auth
LINKEDIN_CLIENT_SECRET=           # LinkedIn Developer Portal > your app > Auth
LINKEDIN_REDIRECT_URI=            # EXACTLY: https://<your-site>.netlify.app/.netlify/functions/callback
LINKEDIN_VERSION=202506           # LinkedIn-Version header for /rest API calls

# ── Security ──────────────────────────────────────────────────────────────────
SCHEDULER_SECRET=                 # Random string — Bearer token protecting the scheduler endpoint
SESSION_SECRET=                   # Random 32+ char string — signs user session tokens (HMAC).
                                  # Changing it logs every user out.
TOKEN_EXPIRY_HOURS=24             # WhatsApp approval link lifetime
MIN_POST_GAP_HOURS=20             # Posting guardrail: minimum spacing between one user's posts
                                  # (rapid-fire API posts are what gets accounts suppressed)

# ── Email approval (Brevo) — PRIMARY approval channel ─────────────────────────
BREVO_API_KEY=                    # Brevo dashboard > SMTP & API > API Keys (starts "xkeysib-")
EMAIL_FROM=                       # A Brevo-VERIFIED sender address (Senders & IP > Senders).
                                  # Free tier verifies a single address (e.g. your Gmail) with
                                  # one click — no domain needed. Sending to anyone else needs
                                  # a verified DOMAIN instead.
EMAIL_FROM_NAME=VISTA             # Display name shown in the recipient's inbox

# ── WhatsApp (CallMeBot) — OPTIONAL legacy channel ────────────────────────────
CALLMEBOT_API_KEY=                # Optional. From callmebot.com — message the bot from YOUR
                                  # WhatsApp to activate. LIMITATION: a key only delivers to the
                                  # phone that registered it (single-recipient), so it can't
                                  # notify real users. Email above is the recommended channel.
                                  # Leave empty to disable WhatsApp entirely.

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=                          # Deployed base URL, e.g. https://vista.netlify.app
                                  # Used to build approval links + validate OAuth return URLs
EXTRA_ALLOWED_ORIGINS=            # Comma-separated extra origins allowed as OAuth return
                                  # targets, e.g. the Vortex domain: https://vortex.example.com
ALLOW_ANON_GENERATION=false       # true = analyze/generate work WITHOUT LinkedIn login
                                  # (handy for demos before OAuth is configured)

# VISTA Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git. Only .env.example is committed.
# Maintained by: Opus (Phase 0 and Phase 3)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=                     # Project URL: Supabase dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=        # Service role key (NOT anon key) — server-side only

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=                   # From Google AI Studio: aistudio.google.com

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=               # From LinkedIn Developer Portal > App > Auth
LINKEDIN_CLIENT_SECRET=           # From LinkedIn Developer Portal > App > Auth
LINKEDIN_REDIRECT_URI=            # Must match exactly: https://yourdomain.netlify.app/.netlify/functions/callback

# ── Security ──────────────────────────────────────────────────────────────────
SCHEDULER_SECRET=                 # Random string — used as Bearer token to protect scheduler endpoint
TOKEN_EXPIRY_HOURS=24             # How long WhatsApp approval links stay valid

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=                          # Full URL of your deployed app e.g. https://vista.netlify.app
